<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.amoo.executor" android:versionCode="2" android:versionName="0.2.0">
    <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="@string/app_name" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="true" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".PhoneToolsService" android:exported="true" android:permission="android.permission.BIND_APP_FUNCTION_SERVICE">
            <property android:name="android.app.appfunctions" android:value="app_functions.xml" />
            <property android:name="android.app.appfunctions.v2" android:value="app_functions_v2.xml" />
            <property android:name="android.app.appfunctions.schema" android:value="app_functions_schema.xsd" />
            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>
        <service android:name=".AmooAccessibilityService" android:exported="true" android:label="@string/app_name" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
