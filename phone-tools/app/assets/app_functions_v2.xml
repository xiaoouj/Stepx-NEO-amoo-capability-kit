<?xml version='1.0' encoding='utf-8'?>
<appfunctions>
  <appfunction>
    <id>com.amoo.executor.PhoneTools#openSettings</id>
    <enabledByDefault>true</enabledByDefault>
    <description>补充高级设置直达：开发者选项、无线调试、输入法设置、电池健康度。原生能力可用时优先原生；用户指定本机工具或原生缺少入口、调用失败时使用。只打开页面，不切换开关。</description>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>page</name>
      <description>页面名称或id：developer/开发者选项、wireless-debugging/无线调试、keyboard/输入法设置、battery-health/电池健康度</description>
    </parameters>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.amoo.executor.PhoneTools#openSettings</functionId>
  </appfunction>
  <appfunction>
    <id>com.amoo.executor.PhoneTools#navigate</id>
    <enabledByDefault>true</enabledByDefault>
    <description>本机工具的补充系统导航。原生导航可用时优先原生；用户指定本机工具或原生失败时可用home返回桌面、back返回上一页、recents查看最近任务。home不强制结束进程。</description>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>action</name>
      <description>导航动作，只能是home、back或recents</description>
    </parameters>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.amoo.executor.PhoneTools#navigate</functionId>
  </appfunction>
  <appfunction>
    <id>com.amoo.executor.PhoneTools#searchSettings</id>
    <enabledByDefault>true</enabledByDefault>
    <description>按中文名称、组件名或关键字查询这台手机的设置索引。返回静态候选；未登记的候选不能当作已验证直达页面。</description>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>query</name>
      <description>设置关键词，例如无线调试、开发者、键盘、电池健康</description>
    </parameters>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.amoo.executor.PhoneTools#searchSettings</functionId>
  </appfunction>
  <appfunction>
    <id>com.amoo.executor.PhoneTools#getToolStatus</id>
    <enabledByDefault>true</enabledByDefault>
    <description>检查AMOO本机工具状态：本机执行服务是否就绪，无障碍服务是否已连接。不可用时报告实际缺项，不声称动作已完成。</description>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.amoo.executor.PhoneTools#getToolStatus</functionId>
  </appfunction>
  <appfunction>
    <id>com.amoo.executor.PhoneTools#screenshot</id>
    <enabledByDefault>true</enabledByDefault>
    <description>截取当前屏幕并保存为PNG，返回图片URI、手机本机路径、宽高和字节数。不返回图片内容、不上传、不记录。可读取返回的path；要理解界面文字应优先使用executor_ui_dump。</description>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.amoo.executor.PhoneTools#screenshot</functionId>
  </appfunction>
  <appfunction>
    <id>com.amoo.executor.PhoneTools#uiDump</id>
    <enabledByDefault>true</enabledByDefault>
    <description>读取当前屏幕的无障碍节点树，返回窗口、文字、描述、控件ID、可点击/可编辑状态和屏幕坐标bounds。点击或输入前先用它定位控件。maxNodes可选，字符串形式的整数，默认200，范围1-1000。</description>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>true</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>false</isRequired>
      <name>maxNodes</name>
      <description>可选，字符串形式的整数，默认200，范围1-1000</description>
    </parameters>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.amoo.executor.PhoneTools#uiDump</functionId>
  </appfunction>
  <appfunction>
    <id>com.amoo.executor.PhoneTools#tap</id>
    <enabledByDefault>true</enabledByDefault>
    <description>按屏幕坐标点击一次。先用executor_ui_dump取得目标bounds，取中心点作为x、y。x和y是字符串形式的整数屏幕坐标。坐标越界或无障碍未连接时返回错误。</description>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>x</name>
      <description>点击横坐标，字符串形式的整数</description>
    </parameters>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>y</name>
      <description>点击纵坐标，字符串形式的整数</description>
    </parameters>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.amoo.executor.PhoneTools#tap</functionId>
  </appfunction>
  <appfunction>
    <id>com.amoo.executor.PhoneTools#swipe</id>
    <enabledByDefault>true</enabledByDefault>
    <description>按屏幕坐标滑动。x1,y1为起点，x2,y2为终点，均为字符串形式的整数屏幕坐标；durationMs可选，默认300毫秒，范围1-5000。</description>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>x1</name>
      <description>起点横坐标，字符串形式的整数</description>
    </parameters>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>y1</name>
      <description>起点纵坐标，字符串形式的整数</description>
    </parameters>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>x2</name>
      <description>终点横坐标，字符串形式的整数</description>
    </parameters>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>y2</name>
      <description>终点纵坐标，字符串形式的整数</description>
    </parameters>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>true</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>false</isRequired>
      <name>durationMs</name>
      <description>可选，滑动时长毫秒，字符串形式的整数，默认300</description>
    </parameters>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.amoo.executor.PhoneTools#swipe</functionId>
  </appfunction>
  <appfunction>
    <id>com.amoo.executor.PhoneTools#inputText</id>
    <enabledByDefault>true</enabledByDefault>
    <description>向当前获得焦点或界面中的可编辑输入框写入文字，并回读确认。通常先用executor_tap点击输入框。text为空字符串可清空；最多2000字符。返回verified表示是否回读一致；密码框跳过回读。输入内容不会记录或上传。</description>
    <parameters>
      <dataTypeMetadata>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </dataTypeMetadata>
      <id>unused</id>
      <isRequired>true</isRequired>
      <name>text</name>
      <description>要写入的文字，可为空字符串以清空，最多2000字符</description>
    </parameters>
    <response>
      <id>unused</id>
      <valueType>
        <id>unused</id>
        <isNullable>false</isNullable>
        <type>8</type>
      </valueType>
    </response>
    <functionId>com.amoo.executor.PhoneTools#inputText</functionId>
  </appfunction>
</appfunctions>